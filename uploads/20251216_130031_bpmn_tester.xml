<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://example.com/bpmn">

  <process id="mock_process_1" name="Mock Process" isExecutable="true">

    <!-- Start Event -->
    <startEvent id="start_event" name="Start">
      <outgoing>flow1</outgoing>
    </startEvent>

    <!-- Task 1 -->
    <task id="task_1" name="Check Order">
      <incoming>flow1</incoming>
      <outgoing>flow2</outgoing>
    </task>

    <!-- Exclusive Gateway -->
    <exclusiveGateway id="gateway_1" name="Order OK?">
      <incoming>flow2</incoming>
      <outgoing>flow3</outgoing>
      <outgoing>flow4</outgoing>
    </exclusiveGateway>

    <!-- Task 2a -->
    <task id="task_2a" name="Approve Order">
      <incoming>flow3</incoming>
      <outgoing>flow5</outgoing>
    </task>

    <!-- Task 2b -->
    <task id="task_2b" name="Reject Order">
      <incoming>flow4</incoming>
      <outgoing>flow6</outgoing>
    </task>

    <!-- End Event -->
    <endEvent id="end_event_approved" name="Order Approved">
      <incoming>flow5</incoming>
    </endEvent>

    <endEvent id="end_event_rejected" name="Order Rejected">
      <incoming>flow6</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="flow1" sourceRef="start_event" targetRef="task_1"/>
    <sequenceFlow id="flow2" sourceRef="task_1" targetRef="gateway_1"/>
    <sequenceFlow id="flow3" sourceRef="gateway_1" targetRef="task_2a"/>
    <sequenceFlow id="flow4" sourceRef="gateway_1" targetRef="task_2b"/>
    <sequenceFlow id="flow5" sourceRef="task_2a" targetRef="end_event_approved"/>
    <sequenceFlow id="flow6" sourceRef="task_2b" targetRef="end_event_rejected"/>

  </process>
</definitions>
