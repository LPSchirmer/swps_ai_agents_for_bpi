<?xml version="1.0" encoding="UTF-8" ?>
<log xes.version="1.0" xmlns="http://www.xes-standard.org/">
  <extension name="Organizational" prefix="org" uri="http://www.xes-standard.org/org.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  <global scope="trace">
    <string key="concept:name" value="case"/>
  </global>
  <global scope="event">
    <string key="concept:name" value="activity"/>
    <string key="org:resource" value="resource"/>
    <date key="time:timestamp" value="2026-01-04T14:00:00.000+01:00"/>
  </global>
  <trace>
    <string key="concept:name" value="Case 1"/>
    <event>
      <string key="concept:name" value="register request"/>
      <string key="org:resource" value="Pete"/>
      <date key="time:timestamp" value="2026-01-04T14:00:00.000+01:00"/>
    </event>
    <event>
      <string key="concept:name" value="automate ticket check"/>
      <string key="org:resource" value="System"/>
      <date key="time:timestamp" value="2026-01-04T14:05:00.000+01:00"/>
    </event>
    <event>
      <string key="concept:name" value="assign case manager"/>
      <string key="org:resource" value="Ellen"/>
      <date key="time:timestamp" value="2026-01-04T14:10:00.000+01:00"/>
    </event>
    <event>
      <string key="concept:name" value="examine casually"/>
      <string key="org:resource" value="Mike"/>
      <date key="time:timestamp" value="2026-01-04T14:20:00.000+01:00"/>
    </event>
    <event>
      <string key="concept:name" value="decide"/>
      <string key="org:resource" value="Sara"/>
      <date key="time:timestamp" value="2026-01-04T14:40:00.000+01:00"/>
    </event>
    <event>
      <string key="concept:name" value="pay compensation"/>
      <string key="org:resource" value="System"/>
      <date key="time:timestamp" value="2026-01-04T15:00:00.000+01:00"/>
    </event>
  </trace>
  <!-- Additional traces for other cases can be added here following the same pattern -->
</log>