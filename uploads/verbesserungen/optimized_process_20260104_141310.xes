<?xml version="1.0" encoding="UTF-8" ?>
<!-- XES file for the optimized warranty handling process -->
<log xes.version="1849.2016" xes.features="nested-attributes" xmlns="http://www.xes-standard.org/">
    <extension name="Organizational" prefix="org" uri="http://www.xes-standard.org/organizational.xesext"/>
    <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
    <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
    <global scope="trace">
        <string key="concept:name" value="optimized_warranty_process"/>
    </global>
    <global scope="event">
        <string key="concept:name" value=""/>
        <string key="org:resource" value=""/>
        <date key="time:timestamp" value=""/>
    </global>
    <trace>
        <string key="concept:name" value="Case 1"/>
        <event>
            <string key="concept:name" value="register request"/>
            <string key="org:resource" value="Pete"/>
            <date key="time:timestamp" value="2026-01-01T09:00:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="automated ticket check"/>
            <string key="org:resource" value="system"/>
            <date key="time:timestamp" value="2026-01-01T09:05:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="examine thoroughly"/>
            <string key="org:resource" value="Sean"/>
            <date key="time:timestamp" value="2026-01-01T10:00:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="decide"/>
            <string key="org:resource" value="Sara"/>
            <date key="time:timestamp" value="2026-01-01T11:00:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="pay compensation"/>
            <string key="org:resource" value="system"/>
            <date key="time:timestamp" value="2026-01-01T11:30:00.000+01:00"/>
        </event>
    </trace>
    <trace>
        <string key="concept:name" value="Case 2"/>
        <event>
            <string key="concept:name" value="register request"/>
            <string key="org:resource" value="Mike"/>
            <date key="time:timestamp" value="2026-01-02T09:00:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="automated ticket check"/>
            <string key="org:resource" value="system"/>
            <date key="time:timestamp" value="2026-01-02T09:03:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="examine casually"/>
            <string key="org:resource" value="Ellen"/>
            <date key="time:timestamp" value="2026-01-02T09:30:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="decide"/>
            <string key="org:resource" value="Sara"/>
            <date key="time:timestamp" value="2026-01-02T10:00:00.000+01:00"/>
        </event>
        <event>
            <string key="concept:name" value="reject request"/>
            <string key="org:resource" value="system"/>
            <date key="time:timestamp" value="2026-01-02T10:30:00.000+01:00"/>
        </event>
